# ---- sites: interface (blue), nucleotide pocket (gold), far-from-site hot-spots as red spheres
color gray85, kras_A
color marine, interface_res
color yellow, pocket_res
show spheres, allo_true and name CA
set sphere_scale, 0.9, allo_true and name CA
color red, allo_true
png results/figures/pymol_sites_measured.png, width=2400, height=2000, dpi=300, ray=1
hide spheres, allo_true
show spheres, allo_lora and name CA
set sphere_scale, 0.9, allo_lora and name CA
color red, allo_lora
png results/figures/pymol_sites_lora.png, width=2400, height=2000, dpi=300, ray=1
hide spheres, allo_lora
show spheres, allo_zeroshot and name CA
set sphere_scale, 0.9, allo_zeroshot and name CA
color red, allo_zeroshot
png results/figures/pymol_sites_zeroshot.png, width=2400, height=2000, dpi=300, ray=1
hide spheres, allo_zeroshot
show spheres, hits and name CA
set sphere_scale, 0.9, hits and name CA
color red, hits
png results/figures/pymol_sites_lora_hits.png, width=2400, height=2000, dpi=300, ray=1
hide spheres, hits
# hits = far-from-site hot-spots that LoRA predicted AND that are truly strong
